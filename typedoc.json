{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["src/index.ts", "src/llama/pdfMarkdownReader.ts"],
  "out": "docs/reference/api",
  "plugin": ["typedoc-plugin-markdown"],
  "hideBreadcrumbs": true,
  "hidePageHeader": true,
  "readme": "none",
  "githubPages": false,
  "useCodeBlocks": true,
  "expandObjects": false,
  "parametersFormat": "list",
  "propertiesFormat": "list",
  "enumMembersFormat": "list",
  "indexFormat": "table",
  "skipErrorChecking": true
}
